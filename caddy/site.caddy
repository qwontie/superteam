{$SUPERTEAM_DOMAIN} {
	handle /api/ai/deal/stream {
		reverse_proxy pact-api:8000 {
			flush_interval -1
		}
	}

	handle_path /proof/* {
		header Cache-Control "no-store"
		reverse_proxy pact-demo:80
	}

	handle /api/* {
		encode zstd gzip
		reverse_proxy pact-api:8000
	}

	handle {
		encode zstd gzip
		reverse_proxy pact-web:80
	}
}
