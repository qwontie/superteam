{
  "compilerOptions": {
    "types": ["mocha", "node"],
    "lib": ["es2022"],
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts"]
}
